#!/usr/bin/env python3
"""Reject private machine data in tracked text, including this checker itself.

Use --self-test to prove the check rejects planted data. Optional allowances
are regular expressions in .personal-data-allow, matching file:line: value.
"""
import argparse
import getpass
import ipaddress
import os
import re
import socket
import subprocess
import sys
import tempfile
from pathlib import Path


def git(root, *args):
    return subprocess.check_output(['git', '-C', str(root), *args], stderr=subprocess.PIPE)


def scan(root):
    root = Path(git(root, 'rev-parse', '--show-toplevel').decode().strip())
    matchers = [
        re.compile(r'/(?:home|Users)/[A-Za-z0-9_.-]+(?:/[^\s\"\x27`<>]*)?'),
        re.compile(r'[A-Za-z0-9._%+-]+@gmail\.com\b'),
        re.compile(r'op://[A-Za-z0-9 _./-]+'),
        re.compile(r'(?<![A-Za-z0-9_.-])[A-Za-z0-9][A-Za-z0-9.-]*\.(?:local|lan|home|ts\.net)(?![A-Za-z0-9_.-])'),
    ]
    generic = {'', 'localhost', 'root', 'runner', 'ubuntu', 'user', 'ci', 'admin', 'node', 'vscode', 'codespace'}
    for value in (getpass.getuser(), socket.gethostname().split('.')[0]):
        if value not in generic:
            matchers.append(re.compile(r'\b' + re.escape(value) + r'\b'))
    allowed = []
    allow_path = root / '.personal-data-allow'
    if allow_path.exists():
        allowed = [re.compile(line) for line in allow_path.read_text().splitlines()
                   if line.strip() and not line.lstrip().startswith('#')]
    hits = []
    for raw in git(root, 'ls-files', '-z').split(b'\0'):
        if not raw:
            continue
        name = raw.decode()
        if 'node_modules' in Path(name).parts or name == '.personal-data-allow':
            continue
        path = root / name
        if path.is_symlink():
            data = os.readlink(path).encode()
        elif path.is_file():
            data = path.read_bytes()
        else:
            continue
        if b'\0' in data:
            continue
        for number, line in enumerate(data.decode('utf-8', errors='replace').splitlines(), 1):
            values = {m.group() for pattern in matchers for m in pattern.finditer(line)}
            for token in re.findall(r'(?<![\w.])(?:\d{1,3}\.){3}\d{1,3}(?![\w.])', line):
                try:
                    address = ipaddress.ip_address(token)
                    if not address.is_loopback and not address.is_unspecified:
                        values.add(token)
                except ValueError:
                    pass
            for value in sorted(values):
                hit = f'{name}:{number}: {value}'
                if not any(pattern.search(hit) for pattern in allowed):
                    hits.append(hit)
    return hits


def self_test():
    with tempfile.TemporaryDirectory(prefix='publication-check-') as directory:
        root = Path(directory)
        git(root, 'init', '-q')
        fixtures = [
            '/' + '/'.join(['home', 'sample-account', 'project']),
            '/' + '/'.join(['Users', 'sample-account', 'project']),
            'private.contact' + '@' + 'gmail.com',
            'op:' + '//' + 'Private/Item/password',
            '.'.join(map(str, [100, 101, 102, 103])),
            'machine' + '.' + 'local',
            'printer' + '.' + 'lan',
            'storage' + '.' + 'home',
            'machine.example' + '.' + 'ts.net',
        ]
        (root / 'sample.txt').write_text('\n'.join(fixtures))
        git(root, 'add', 'sample.txt')
        hits = scan(root)
        for fixture in fixtures:
            assert any(fixture in hit for hit in hits), f'missed planted value: {fixture}'
        assert all(hit.startswith('sample.txt:') for hit in hits)
        print('Negative control: all planted private values rejected.')
        (root / 'sample.txt').write_text('Neutral sample, loopback 127.0.0.1, file .env.local\n')
        (root / 'untracked.txt').write_text(fixtures[0])
        assert scan(root) == [], 'clean tracked data rejected'
        (root / 'sample.txt').write_text(fixtures[2] + '\n')
        (root / '.personal-data-allow').write_text(r'^sample\.txt:1: ' + re.escape(fixtures[2]) + '$\n')
        git(root, 'add', '.personal-data-allow')
        assert scan(root) == [], 'explicit allowance not honored'
        (root / 'sample.txt').write_text(fixtures[2] + '\n' + fixtures[0])
        assert any(fixtures[0] in hit for hit in scan(root)), 'allowance hid unrelated data'
        (root / 'tools').mkdir()
        (root / 'tools/check-no-personal-data').write_text(fixtures[1])
        git(root, 'add', 'tools/check-no-personal-data')
        assert any(hit.startswith('tools/check-no-personal-data:') for hit in scan(root))
        print('Clean data, narrow allowances and checker inclusion passed.')


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('directory', nargs='?', default='.')
    parser.add_argument('--quiet', '-q', action='store_true')
    parser.add_argument('--self-test', action='store_true')
    args = parser.parse_args()
    try:
        if args.self_test:
            self_test()
            return 0
        hits = scan(args.directory)
        if hits:
            if not args.quiet:
                print('check-no-personal-data: rejected tracked content', file=sys.stderr)
                print('\n'.join(hits))
            return 1
        if not args.quiet:
            print('check-no-personal-data: clean')
        return 0
    except (OSError, subprocess.CalledProcessError, re.error, AssertionError) as error:
        print(f'check-no-personal-data: {error}', file=sys.stderr)
        return 2


if __name__ == '__main__':
    sys.exit(main())
